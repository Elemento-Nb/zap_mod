{
	"schemaVersion": 1,
	"id": "zap_mod",
	"version": "${version}",
	"name": "Zap Mod",
	"description": "This is an example description! Tell everyone what your mod is about!",
	"authors": [
		"Me!"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/zap_mod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"fafas.zap_mod.ZapMod"
		],
		"client": [
			"fafas.zap_mod.client.ZapModClient"
		],
		"fabric-datagen": [
			"fafas.zap_mod.client.ZapModDataGenerator"
		]
	},
	"mixins": [
		"zap_mod.mixins.json",
		{
			"config": "zap_mod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}